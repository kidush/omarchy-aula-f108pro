# AULA / Alma F108 Pro: let the logged-in user open the keyboard's hidraw nodes,
# so almactl works without sudo.
# 2.4G dongle (spoofed Apple ID)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="024f", TAG+="uaccess"
# USB cable (Sonix)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="800a", TAG+="uaccess"
